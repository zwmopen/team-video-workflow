{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zwm-device-share-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkspaceRelay"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "REMOTE_OBJECTS",
      "bucket_name": "zwm-device-share-relay"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
