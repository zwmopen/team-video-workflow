<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0F9B63</item>
        <item name="android:navigationBarColor">#F8F9F8</item>
        <item name="android:statusBarColor">#F8F9F8</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- DSH-183：系统弹窗深色适配。AppTheme 写死 Light，弹窗单独按 ThemePalette 选深浅主题 -->
    <style name="AppDialogTheme.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#0F9B63</item>
    </style>
    <style name="AppDialogTheme.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#4BD78C</item>
    </style>
</resources>
