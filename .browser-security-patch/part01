+    if value.startswith("["):
+        closing = value.find("]")
+        if closing < 0:
+            return value, None
+        host = value[1:closing]
+        remainder = value[closing + 1 :]
+        if remainder.startswith(":") and remainder[1:].isdigit():
+            return host, int(remainder[1:])
+        return host, None
+    if value.count(":") == 1:
+        host, raw_port = value.rsplit(":", 1)
+        if raw_port.isdigit():
+            return host, int(raw_port)
+    return value, None
